<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Version>0.0.1</Version>
		<AssemblyName>XSplitScreen</AssemblyName>
		<RootNamespace>Dodad.XSplitscreen</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="xsplitscreenbundle" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="xsplitscreenbundle" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Core" Version="5.4.21" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
		<PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
		<PackageReference Include="MMHOOK.RoR2" Version="2026.10.8">
			<NoWarn>NU1701</NoWarn>
		</PackageReference>
		<PackageReference Include="R2API.Core" Version="5.3.0" />
		<PackageReference Include="R2API.Language" Version="1.1.0" />
	</ItemGroup>

	<!--
		Optional: copy the built plugin into a mod manager profile after each build.
		Set PluginDeployDir in XSplitScreen.csproj.user (not committed).
		See XSplitScreen.csproj.user.example.
	-->
	<Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(PluginDeployDir)' != ''">
		<MakeDir Directories="$(PluginDeployDir)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
		<Message Importance="high" Text="Deployed $(TargetFileName) to $(PluginDeployDir)" />
	</Target>

</Project>
